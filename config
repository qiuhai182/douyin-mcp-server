[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[branch "main"]
	remote = origin
	vscode-merge-base = origin/main
	merge = refs/heads/main
[remote "upstream"]
	url = https://github.com/yzfly/douyin-mcp-server.git
	fetch = +refs/heads/*:refs/remotes/upstream/*
[remote "gitee"]
	url = https://gitee.com/qiuhai182/douyin-mcp-server.git
	fetch = +refs/heads/*:refs/remotes/gitee/*
