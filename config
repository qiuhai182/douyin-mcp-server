[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[branch "main"]
	remote = gitee
	merge = refs/heads/main
[remote "github"]
	url = https://github.com/qiuhai182/douyin-mcp-server.git
	fetch = +refs/heads/*:refs/remotes/github/*
[remote "gitee"]
	url = https://gitee.com/qiuhai182/douyin-mcp-server.git
	fetch = +refs/heads/*:refs/remotes/gitee/*
